{
  "version": 2,
  "builds": [
    {
      "src": "flask_app/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.+\\.(css|js|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot))",
      "dest": "/flask_app/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/flask_app/app.py"
    }
  ]
}
